{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:player-club:v1:manifest",
  "title": "manifest.json",
  "description": "Authoritative schema version and id sequences. Sequences only increase.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "pointSeq", "changeSeq", "updateSeq"],
  "properties": {
    "schemaVersion": { "$ref": "urn:player-club:v1:defs#/$defs/schemaVersion" },
    "pointSeq": { "type": "integer", "minimum": 0 },
    "changeSeq": { "type": "integer", "minimum": 0 },
    "updateSeq": { "type": "integer", "minimum": 0 }
  }
}

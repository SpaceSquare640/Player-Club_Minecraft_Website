{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:player-club:v1:defs",
  "title": "Shared definitions",
  "description": "Reusable definitions for schema version 1. The custom format iana-time-zone must be registered by the validator.",
  "$defs": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "snakeId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,31}$"
    },
    "pointId": {
      "type": "string",
      "pattern": "^p[0-9]{4,}$"
    },
    "changeId": {
      "type": "string",
      "pattern": "^c[0-9]{4,}$"
    },
    "updateId": {
      "type": "string",
      "pattern": "^u[0-9]{4,}$"
    },
    "dimension": {
      "type": "string",
      "enum": ["overworld", "the_nether", "the_end"]
    },
    "plainText": {
      "description": "Single line; no C0 controls, DEL, zero-width or bidi control characters; no leading or trailing whitespace.",
      "type": "string",
      "pattern": "^(?!\\s)(?![\\s\\S]*\\s$)[^\\u0000-\\u001F\\u007F\\u200B-\\u200F\\u202A-\\u202E\\u2066-\\u2069]*$"
    },
    "multilineText": {
      "description": "Same as plainText but allows line feed (U+000A).",
      "type": "string",
      "pattern": "^(?!\\s)(?![\\s\\S]*\\s$)[^\\u0000-\\u0009\\u000B-\\u001F\\u007F\\u200B-\\u200F\\u202A-\\u202E\\u2066-\\u2069]*$"
    },
    "localizedText30": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "zh-TW"],
      "properties": {
        "en": { "type": "string", "$ref": "#/$defs/plainText", "minLength": 1, "maxLength": 30 },
        "zh-TW": { "type": "string", "$ref": "#/$defs/plainText", "minLength": 1, "maxLength": 30 }
      }
    },
    "localizedText100": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "zh-TW"],
      "properties": {
        "en": { "type": "string", "$ref": "#/$defs/plainText", "minLength": 1, "maxLength": 100 },
        "zh-TW": { "type": "string", "$ref": "#/$defs/plainText", "minLength": 1, "maxLength": 100 }
      }
    },
    "localizedText120": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "zh-TW"],
      "properties": {
        "en": { "type": "string", "$ref": "#/$defs/plainText", "minLength": 1, "maxLength": 120 },
        "zh-TW": { "type": "string", "$ref": "#/$defs/plainText", "minLength": 1, "maxLength": 120 }
      }
    },
    "localizedText200": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "zh-TW"],
      "properties": {
        "en": { "type": "string", "$ref": "#/$defs/plainText", "minLength": 1, "maxLength": 200 },
        "zh-TW": { "type": "string", "$ref": "#/$defs/plainText", "minLength": 1, "maxLength": 200 }
      }
    },
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "githubLogin": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"
    },
    "utcTimestamp": {
      "description": "UTC time without milliseconds, e.g. 2026-09-29T08:00:00Z.",
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "calendarDate": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "gameVersionNumber": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$"
    },
    "bounds": {
      "description": "yMin < yMax is checked by cross validation.",
      "type": "object",
      "additionalProperties": false,
      "required": ["xzAbsMax", "yMin", "yMax"],
      "properties": {
        "xzAbsMax": { "type": "integer", "minimum": 1, "maximum": 30000000 },
        "yMin": { "type": "integer" },
        "yMax": { "type": "integer" }
      }
    }
  }
}
